# Copy to .env.local for local development (Expo loads it automatically).
# Where the app reaches the API. Defaults: http://10.0.2.2:4000 on the Android emulator,
# http://localhost:4000 on the iOS simulator and web. On a physical phone use your
# computer's LAN address, e.g. http://192.168.1.20:4000.
# Release builds take this from eas.json and must use https.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Google sign-in (Android/iOS builds only; hidden in Expo Go and on web).
# The *Web application* OAuth client ID from Google Cloud console. Put the same value in the
# backend's GOOGLE_CLIENT_IDS. Android also needs an Android OAuth client with this app's
# package name (com.manmathx.studyplanner) and SHA-1 (`npx eas-cli credentials`).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS only: the iOS OAuth client ID, and its reversed form for the build.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=
