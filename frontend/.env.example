# Copy to .env.local for local development (Expo loads it automatically).
# Where the app reaches the API. Defaults: http://10.0.2.2:4000 on the Android emulator,
# http://localhost:4000 on the iOS simulator and web. On a physical phone use your
# computer's LAN address, e.g. http://192.168.1.20:4000.
# Release builds take this from eas.json and must use https.
EXPO_PUBLIC_API_URL=http://localhost:4000
