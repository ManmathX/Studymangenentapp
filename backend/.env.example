# Copy to .env and fill in. Never commit .env files.
# NODE_ENV: development | staging | production (tests set "test" themselves)
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB must run as a replica set (transactions). Local single-node example:
MONGODB_URI=mongodb://127.0.0.1:27017/study_planner?replicaSet=rs0
MONGODB_MAX_POOL_SIZE=20

# Optional. When set, rate limits are shared across API instances through Redis.
REDIS_URL=redis://127.0.0.1:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Staging and production refuse to start with this example value.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=study-planner-api
JWT_AUDIENCE=study-planner-app
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=10

# Comma-separated origins allowed by CORS (Expo web dev server runs on 8081).
# Native apps send no Origin header and are always allowed.
# 5173 is the admin portal (adminwebsite) dev server.
# Use * to allow every origin (safe here: auth uses Bearer tokens, not cookies).
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:5173
# Google sign-in: comma-separated OAuth client IDs whose ID tokens are accepted. Use the
# *Web application* client ID the app passes as EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID (add the iOS
# client ID too if iOS signs in with its own). Leave empty to turn Google sign-in off.
GOOGLE_CLIENT_IDS=
# Forgot password: 6-digit codes are emailed through this SMTP server. Leave empty to turn it off.
# Any provider works, e.g. Gmail with an app password (the @ in the user is written %40):
#   SMTP_URL=smtps://you%40gmail.com:your-app-password@smtp.gmail.com:465
SMTP_URL=
# Sender shown on the email. Required when SMTP_URL is set.
MAIL_FROM=Study Planner <no-reply@example.com>
PASSWORD_RESET_CODE_TTL_MINUTES=15
# Number of proxy hops to trust for client IPs (1 behind a single load balancer, 0 when exposed directly)
TRUST_PROXY=0

RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MINUTE=300
# Login, register, refresh, password change and account deletion attempts per IP per window
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_MINUTES=15

# Swagger UI at /docs. Defaults to on, except when NODE_ENV=production.
# API_DOCS_ENABLED=false

# Used only by `npm run create-admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# Set to true to also reset the password of an existing account being promoted
ADMIN_RESET_PASSWORD=false
